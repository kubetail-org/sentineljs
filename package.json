{
  "name": "sentinel-js",
  "version": "0.0.7",
  "license": "MIT",
  "description": "JS library that detects new DOM nodes using CSS selectors",
  "keywords": [
    "dom",
    "detect",
    "watch"
  ],
  "homepage": "https://github.com/muicss/sentineljs",
  "bugs": {
    "url": "https://github.com/muicss/sentineljs/issues",
    "email": "contact@muicss.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/muicss/sentineljs.git"
  },
  "source": "src/sentinel.js",
  "main": "dist/sentinel.js",
  "module": "dist/sentinel.module.js",
  "unpkg": "dist/sentinel.umd.js",
  "types": "src/sentinel.d.ts",
  "scripts": {
    "build": "microbundle --name sentinel --format umd,cjs,esm --no-compress",
    "dev": "microbundle watch --name sentinel --format umd,cjs,esm --no-compress",
    "docs:gen": "node scripts/build-docs-data.js",
    "docs:build": "npm run docs:gen && typedoc",
    "docs:watch": "onchange 'examples/*.html' 'src/*.js' -- npm run docs:build",
    "test": "web-test-runner"
  },
  "devDependencies": {
    "@esm-bundle/chai": "^4.3.4-fix.0",
    "@web/test-runner": "^0.20.2",
    "microbundle": "^0.15.1",
    "typedoc": "^0.28.16"
  }
}
